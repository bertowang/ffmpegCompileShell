{
  "schema": 2,
  "profile": "capture",
  "updated": "2026-10-19",
  "description": "开播(capture)专用的依赖锁定文件：固定每个库的来源地址、版本与 commit。给定本文件即可复现出完全相同的目标库；升级版本只需改这里。",
  "rules": {
    "internal": "ffmpeg、fdk-aac 使用内网仓库 https://git.woa.com/EST/media/e-ffmpeg/<name>.git",
    "others": "其余库使用上游官方仓库，取截止 updated 日期的最新正式发布版（release tag）；为兼容 MediaX 时锁旧版并在 note 中说明"
  },
  "groups": {
    "ffmpeg": {
      "description": "FFmpeg 自身源码。本文件只描述开播(capture)用途；产物用 profile=capture 标记区分",
      "build_input_of": null,
      "profiles": {
        "capture": {
          "enabled": true,
          "description": "开播链路：采集 → 编码 → 封装(flv/mpegts) → 推流(rtmp/rtmps/srt)；裁剪白名单见 ffmpeg_build/config.py",
          "libraries": {
            "ffmpeg": {
              "kind": "git",
              "version": "6.1.6",
              "profile": "capture",
              "homepage": "https://git.woa.com/EST/media/e-ffmpeg/ffmpeg-6.1.6",
              "url": "https://git.woa.com/EST/media/e-ffmpeg/ffmpeg-6.1.6.git",
              "tag": "",
              "ref": "3c1fc5dfaec5687d9c418e119f1dadd7a97553b1",
              "commit": "3c1fc5dfaec5687d9c418e119f1dadd7a97553b1",
              "internal": true,
              "platform_overrides": {
                "ohos": {
                  "kind": "git",
                  "version": "ohos-n6.1.2_dev",
                  "url": "https://gitee.com/openharmony-tpc-incubate/FFmpeg.git",
                  "tag": "",
                  "ref": "ohos-n6.1.2_dev",
                  "commit": "",
                  "note": "OHOS 需 openharmony-tpc 的 fork（--enable-ohosavcodecdecoder 仅该分支有）"
                },
                "linux": {
                  "kind": "git",
                  "version": "6.1.6",
                  "url": "https://github.com/FFmpeg/FFmpeg.git",
                  "tag": "n6.1.6",
                  "ref": "n6.1.6",
                  "commit": "f1e3a2bf7a2f2cde936d1ed97f09a26853d20125",
                  "internal": false,
                  "note": "内网 git.woa.com 需要工蜂鉴权，在 Linux 构建机上匿名拉取会失败；故该平台改用上游官方仓库的同版本 n6.1.6（版本与内网版一致，commit 单独锁定保证可复现）；9266ee0 是 n6.1.6 的附注标签对象，真正的发布 commit 是 f1e3a2b，故锁定后者"
                }
              }
            }
          }
        }
      }
    },
    "ffmpeg_deps": {
      "description": "FFmpeg 的构建期依赖：configure 需对应 --enable-*，产物静态并入 avcodec/avformat。Windows 上应用无需再链；Android 为独立 .so，需随包并显式链接",
      "build_input_of": "ffmpeg",
      "libraries": {
        "zlib": {
          "kind": "archive",
          "version": "1.3.2",
          "homepage": "https://github.com/madler/zlib",
          "url": "https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz",
          "tag": "v1.3.2",
          "commit": "da607da739fa6047df13e66a2af6b8bec7c2a498",
          "strip_components": 1,
          "sha256": "",
          "ffmpeg_flag": "--enable-zlib",
          "note": "FFmpeg 的 png 解码器依赖 zlib（png_decoder_select=inflate_wrapper）；缺它则水印/logo 图片无法解码"
        },
        "openssl": {
          "kind": "archive",
          "version": "3.6.5",
          "homepage": "https://github.com/openssl/openssl",
          "url": "https://github.com/openssl/openssl/releases/download/openssl-3.6.5/openssl-3.6.5.tar.gz",
          "tag": "openssl-3.6.5",
          "commit": "c8bd5a57108599ac650bbae77fcabe3109dab2e8",
          "strip_components": 1,
          "sha256": "",
          "ffmpeg_flag": "--enable-openssl"
        },
        "srt": {
          "kind": "archive",
          "version": "1.5.7",
          "homepage": "https://github.com/Haivision/srt",
          "url": "https://github.com/Haivision/srt/archive/refs/tags/v1.5.7.tar.gz",
          "tag": "v1.5.7",
          "commit": "899348d8318eb9a3c5a5b6ec43c4a1114288773a",
          "strip_components": 1,
          "sha256": "",
          "ffmpeg_flag": "--enable-libsrt"
        },
        "fdk-aac": {
          "kind": "git",
          "version": "2.0.3",
          "homepage": "https://git.woa.com/EST/media/e-ffmpeg/fdk_aac_v2.0.3",
          "url": "https://git.woa.com/EST/media/e-ffmpeg/fdk_aac_v2.0.3.git",
          "tag": "",
          "ref": "716f4394641d53f0d79c9ddac3fa93b03a49f278",
          "commit": "716f4394641d53f0d79c9ddac3fa93b03a49f278",
          "internal": true,
          "ffmpeg_flag": "--enable-libfdk-aac",
          "platform_overrides": {
            "linux": {
              "kind": "git",
              "version": "2.0.3",
              "url": "https://github.com/mstorsjo/fdk-aac.git",
              "tag": "v2.0.3",
              "ref": "v2.0.3",
              "commit": "716f4394641d53f0d79c9ddac3fa93b03a49f278",
              "internal": false,
              "note": "上游 v2.0.3 的 commit 与内网 fdk_aac_v2.0.3 逐字节相同（同为 716f4394），只是换下载地址；Linux 上内网不可达时使用"
            }
          },
          "note": "用内网 fdk_aac_v2.0.3（与 FFmpeg 6.1 的 libfdk-aac wrapper 匹配；上游 v3.0.0 为大版本跨越，暂不升级）"
        },
        "openh264": {
          "kind": "archive",
          "version": "2.6.0",
          "homepage": "https://github.com/cisco/openh264",
          "url": "https://github.com/cisco/openh264/archive/refs/tags/v2.6.0.tar.gz",
          "tag": "v2.6.0",
          "commit": "652bdb7719f30b52b08e506645a7322ff1b2cc6f",
          "strip_components": 1,
          "sha256": "",
          "ffmpeg_flag": "--enable-libopenh264"
        }
      }
    },
    "standalone": {
      "description": "与 FFmpeg 无关的独立库：不参与 FFmpeg 构建，由应用直接链接（或 header-only 直接包含）",
      "build_input_of": null,
      "libraries": {
        "libyuv": {
          "kind": "git",
          "version": "1974",
          "homepage": "https://chromium.googlesource.com/libyuv/libyuv",
          "url": "https://chromium.googlesource.com/libyuv/libyuv",
          "tag": "",
          "ref": "2404f9730e2e48946d29c6d28e3b630302a8d842",
          "commit": "2404f9730e2e48946d29c6d28e3b630302a8d842",
          "note": "libyuv 无 release tag，锁上游 HEAD；version 字段为 LIBYUV_VERSION"
        },
        "json": {
          "kind": "archive",
          "layout": "portable",
          "output_subdirs": [
            "single_include"
          ],
          "version": "3.12.0",
          "homepage": "https://github.com/nlohmann/json",
          "url": "https://github.com/nlohmann/json/releases/download/v3.12.0/include.zip",
          "tag": "v3.12.0",
          "commit": "55f93686c01528224f448c19128836e7df245f72",
          "strip_components": 0,
          "sha256": ""
        },
        "spdlog": {
          "kind": "git",
          "version": "v1.14.1",
          "homepage": "https://github.com/gabime/spdlog",
          "url": "https://github.com/gabime/spdlog.git",
          "tag": "v1.14.1",
          "ref": "27cb4c76708608465c413f6d0e6b8d99a4d84302",
          "commit": "27cb4c76708608465c413f6d0e6b8d99a4d84302",
          "note": "锁 v1.14.1：MediaX 的 find_package(spdlog 1.14.1 REQUIRED) 与 ESLogger 基于此版本（上游最新 v1.17.0，升级需同步改 MediaX 侧）"
        }
      }
    },
    "text": {
      "description": "文字渲染（时间水印等）的字形库：只有 build --with-text 才编译（或 --libs freetype 显式点名）；默认构建不含。与 FFmpeg 无关 —— ffmpeg 不开 --enable-libfreetype / drawtext，由 TGCapture 内核（-DTG_WITH_TEXT=ON）直接链接",
      "build_input_of": null,
      "libraries": {
        "freetype": {
          "kind": "archive",
          "version": "2.15.0",
          "homepage": "https://freetype.org",
          "url": "https://download.savannah.gnu.org/releases/freetype/freetype-2.15.0.tar.xz",
          "tag": "VER-2-15-0",
          "commit": "37515cf56ba3349656049edbed89ffc6f6466f2d",
          "strip_components": 1,
          "sha256": "93cd47eb719c325107f2d3cf087d06299e944c3b48a40b55537302304dea1dd5",
          "license": "FTL（BSD 风格，需在产品文档中致谢）/ GPLv2 双授权，任选其一",
          "note": "最小化构建：关闭 zlib / bzip2 / png / harfbuzz / brotli（用自带的 gzip 解码；不需要彩色 emoji 与复杂文字排版），零传递依赖"
        }
      }
    },
    "ffmpeg_hw_sdks": {
      "description": "桌面硬编 SDK：ffmpeg 的构建期输入（不是要编译的库）。只有 --enable-nvenc / --enable-amf 时才拉取；platforms 决定平台适用范围（目前只有 windows，iOS/Android 走 videotoolbox / mediacodec，不用这些 SDK）。头文件不安装到产物目录——运行期靠显卡驱动，不需要头文件",
      "build_input_of": "ffmpeg",
      "libraries": {
        "amf": {
          "kind": "git",
          "version": "1.4.34",
          "platforms": [
            "windows"
          ],
          "homepage": "https://github.com/GPUOpen-LibrariesAndSDKs/AMF",
          "url": "https://github.com/GPUOpen-LibrariesAndSDKs/AMF.git",
          "tag": "v1.4.34",
          "ref": "6d7bec0469961e2891c6e1aaa5122b76ed82e1db",
          "commit": "6d7bec0469961e2891c6e1aaa5122b76ed82e1db",
          "internal": false,
          "depth": 1,
          "partial": true,
          "sparse": [
            "amf/public/include"
          ],
          "include_dir": "amf/public/include",
          "header_prefix": "AMF",
          "marker": "AMF/core/Version.h",
          "ffmpeg_flag": "--enable-amf",
          "extra_flags": [
            "--enable-d3d11va"
          ],
          "note": "AMD AMF：h264_amf / hevc_amf / av1_amf 编码器。直接用上游 GitHub 并锁 tag v1.4.34（ffmpeg 6.1 要求 AMF >= 1.4.29，该 tag 的 Version.h = 1.4.34.0）。仓库里头文件在 amf/public/include/{core,components}，没有 AMF/ 这一层；ffmpeg 写的是 #include <AMF/core/Version.h>，故构建时规整出 <out>/amf/windows/include/AMF/...。仓库自带 Thirdparty/（DeckLink SDK、预编译 ffmpeg-6.0 等约 490MB）只服务于 AMF 自己的 samples，构建用不到，因此 sparse 只检出 amf/public/include：--depth 1 + --filter=blob:none + sparse-checkout，其余内容连字节都不下载"
        },
        "nv-codec-headers": {
          "kind": "git",
          "version": "12.0.16.1",
          "platforms": [
            "windows"
          ],
          "homepage": "https://github.com/FFmpeg/nv-codec-headers",
          "url": "https://github.com/FFmpeg/nv-codec-headers.git",
          "tag": "n12.0.16.1",
          "ref": "451da99614412a7f9526ef301a5ee0c7a6f9ad76",
          "commit": "451da99614412a7f9526ef301a5ee0c7a6f9ad76",
          "internal": false,
          "depth": 1,
          "include_dir": "include",
          "marker": "ffnvcodec/nvEncodeAPI.h",
          "pkgconfig_template": "ffnvcodec.pc.in",
          "ffmpeg_flag": "--enable-nvenc",
          "extra_flags": [
            "--enable-ffnvcodec"
          ],
          "note": "NVIDIA nv-codec-headers：h264_nvenc / hevc_nvenc 编码器。直接用上游 GitHub，锁 tag n12.0.16.1（上游 tag 名带 n 前缀，commit 取剥壳后的 451da996；其 ffnvcodec.pc.in 与内网镜像逐字节一致）。该版本对应 Video Codec SDK 12.0.16，与 ffmpeg 6.1.6 匹配；升到 13.x 会抬高运行期驱动要求。仓库只有 include/ffnvcodec/*.h，无需 sparse。ffmpeg 用 check_pkg_config 找 ffnvcodec（要带版本号的 .pc），故构建时按 .pc.in 生成 ffnvcodec.pc（版本 12.0.16.1）；extra_flags 里的 --enable-ffnvcodec 不能省——--disable-everything 会连外部库 ffnvcodec 一起关掉，nvenc 的依赖就满足不了"
        }
      }
    }
  }
}
