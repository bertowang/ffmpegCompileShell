# TGCapture3rdConfig.cmake —— 由 FfmpegCompileShell 生成到产物根目录，请勿手改。
# 重新生成：python build.py export -o <产物根目录>（每次 build 结束也会自动刷新）
#
# 用法（标准 CMake 包，find_package 的 CONFIG 模式）：
#   cmake -DCMAKE_PREFIX_PATH=<产物根目录> ...      # 或 -DTGCapture3rd_DIR=<产物根目录>
#   find_package(TGCapture3rd 1 CONFIG REQUIRED COMPONENTS ffmpeg libyuv)
#   target_link_libraries(app PRIVATE TGCapture3rd::avformat TGCapture3rd::avcodec TGCapture3rd::libyuv)
#
# 交叉编译（Android / OHOS 工具链把 find_package 限定在 sysroot 里）时，加 NO_CMAKE_FIND_ROOT_PATH，
# 或直接给 -DTGCapture3rd_DIR=<产物根目录>。
#
# 可选输入（不设则按当前工具链自动推断）：
#   TGCapture3rd_PLATFORM       windows | linux | android | ios | ohos
#   TGCapture3rd_ABI            windows: x64/x86/arm64；linux: x86_64/arm64/armhf；
#                               android / ohos: arm64-v8a/armeabi-v7a/x86_64；ios 为 fat 库，不需要
#   TGCapture3rd_IMPORT_GLOBAL  ON 时导入目标为 GLOBAL（本工程被 add_subdirectory 引入、上层也要看到这些目标时）
#
# 组件 → 导入目标：
#   ffmpeg    TGCapture3rd::avformat / avcodec / avfilter / swscale / swresample / avutil，汇总目标 TGCapture3rd::ffmpeg
#             Windows 为 DLL（SHARED IMPORTED，带 IMPORTED_IMPLIB），可直接用 $<TARGET_RUNTIME_DLLS:app> 拷贝；
#             其它平台为静态库，openssl/srt/fdk-aac/openh264/zlib 与系统库按 ffmpeg 的 .pc 自动带上
#   openssl   TGCapture3rd::ssl / TGCapture3rd::crypto，汇总目标 TGCapture3rd::openssl
#   zlib srt fdk-aac openh264 libyuv spdlog json   TGCapture3rd::<组件名>
#
# 输出变量：
#   TGCapture3rd_FOUND、TGCapture3rd_<组件>_FOUND / _PREFIX / _VERSION、
#   TGCapture3rd_ROOT、TGCapture3rd_PLATFORM、TGCapture3rd_ABI、TGCapture3rd_PROFILE、
#   TGCapture3rd_RUNTIME_DLLS（Windows 下 ffmpeg 的 DLL 列表）

# find_package 加载包配置时自带独立的策略作用域，这里设置的策略不会影响调用方
cmake_policy(VERSION 3.16...3.31)

get_filename_component(TGCapture3rd_ROOT "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
# 依赖在前、ffmpeg 最后：静态 ffmpeg 要引用前面这些库的导入目标
set(TGCapture3rd_ALL_COMPONENTS zlib openssl srt fdk-aac openh264 libyuv spdlog json ffmpeg)
set(_TG3_FFMPEG_DEPS zlib openssl srt fdk-aac openh264)
set(_TG3_FFMPEG_LIBS avutil swresample swscale postproc avcodec avformat avfilter avdevice)

set(TGCapture3rd_PROFILE "")
if(EXISTS "${TGCapture3rd_ROOT}/.build_profile")
    file(STRINGS "${TGCapture3rd_ROOT}/.build_profile" TGCapture3rd_PROFILE LIMIT_COUNT 1)
endif()

macro(_tg3_fail msg)
    set(TGCapture3rd_FOUND FALSE)
    set(TGCapture3rd_NOT_FOUND_MESSAGE "${msg}")
    return()            # 宏里的 return() 直接结束整个包配置文件
endmacro()

# ------------------------------------------------------------------ 平台 / ABI
if(NOT TGCapture3rd_PLATFORM)
    if(ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "Android")
        set(TGCapture3rd_PLATFORM android)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
        set(TGCapture3rd_PLATFORM ios)
    elseif(OHOS OR CMAKE_SYSTEM_NAME STREQUAL "OHOS")
        set(TGCapture3rd_PLATFORM ohos)
    elseif(WIN32)
        set(TGCapture3rd_PLATFORM windows)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(TGCapture3rd_PLATFORM linux)
    else()
        _tg3_fail("TGCapture3rd 不提供 ${CMAKE_SYSTEM_NAME} 平台的产物（支持 windows/linux/android/ios/ohos），可用 -DTGCapture3rd_PLATFORM= 指定")
    endif()
endif()
set(_tg3_plat "${TGCapture3rd_PLATFORM}")

# Windows：从编译器推断目标架构（与 -A / vcvarsall 一致），用于校验与默认值
set(_tg3_cc_abi "")
if(_tg3_plat STREQUAL "windows")
    foreach(_tg3_lang IN ITEMS CXX C)
        if(CMAKE_${_tg3_lang}_COMPILER_ARCHITECTURE_ID)
            string(TOLOWER "${CMAKE_${_tg3_lang}_COMPILER_ARCHITECTURE_ID}" _tg3_cc_abi)
            break()
        endif()
    endforeach()
    if(NOT _tg3_cc_abi AND CMAKE_GENERATOR_PLATFORM)
        string(TOLOWER "${CMAKE_GENERATOR_PLATFORM}" _tg3_cc_abi)
    endif()
    if(_tg3_cc_abi STREQUAL "win32" OR _tg3_cc_abi STREQUAL "i386")
        set(_tg3_cc_abi x86)
    elseif(_tg3_cc_abi STREQUAL "amd64" OR _tg3_cc_abi STREQUAL "x86_64")
        set(_tg3_cc_abi x64)
    endif()
    if(NOT _tg3_cc_abi AND CMAKE_SIZEOF_VOID_P)
        if(CMAKE_SIZEOF_VOID_P EQUAL 8)
            set(_tg3_cc_abi x64)
        else()
            set(_tg3_cc_abi x86)
        endif()
    endif()
endif()

if(NOT TGCapture3rd_ABI AND NOT _tg3_plat STREQUAL "ios")
    if(_tg3_plat STREQUAL "windows")
        set(TGCapture3rd_ABI "${_tg3_cc_abi}")
    elseif(_tg3_plat STREQUAL "android")
        if(ANDROID_ABI)
            set(TGCapture3rd_ABI "${ANDROID_ABI}")
        else()
            set(TGCapture3rd_ABI "${CMAKE_ANDROID_ARCH_ABI}")
        endif()
    elseif(_tg3_plat STREQUAL "ohos")
        set(TGCapture3rd_ABI "${OHOS_ARCH}")
    elseif(_tg3_plat STREQUAL "linux")
        string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _tg3_proc)
        if(_tg3_proc MATCHES "^(x86_64|amd64)$")
            set(TGCapture3rd_ABI x86_64)
        elseif(_tg3_proc MATCHES "^(aarch64|arm64)")
            set(TGCapture3rd_ABI arm64)
        elseif(_tg3_proc MATCHES "^arm")
            set(TGCapture3rd_ABI armhf)
        endif()
    endif()
    if(NOT TGCapture3rd_ABI)
        _tg3_fail("无法推断 ${_tg3_plat} 的目标 ABI，请用 -DTGCapture3rd_ABI=<abi> 指定")
    endif()
endif()
if(_tg3_plat STREQUAL "ios")
    set(TGCapture3rd_ABI "")          # fat 库：多架构已 lipo 合并，没有 abi 层
endif()
set(_tg3_abi "${TGCapture3rd_ABI}")

if(_tg3_plat STREQUAL "windows" AND _tg3_cc_abi AND NOT _tg3_cc_abi STREQUAL _tg3_abi)
    # 提前拦住：否则要到链接时才报 LNK1112 module machine type 'x64' conflicts with target machine type 'x86'
    _tg3_fail("TGCapture3rd_ABI=${_tg3_abi} 与当前编译器目标架构 ${_tg3_cc_abi} 不一致（检查 -A / vcvarsall 参数）")
endif()

if(TGCapture3rd_IMPORT_GLOBAL OR CMAKE_FIND_PACKAGE_TARGETS_GLOBAL)
    set(_tg3_global GLOBAL)
else()
    set(_tg3_global "")
endif()

# ------------------------------------------------------------------ 目录解析
# 与 FfmpegCompileShell 的布局一致：
#   abi  : <库>/<平台>/<abi>/{include,lib}   android / ohos / linux，或 Windows 一次编多个 ABI
#   flat : <库>/<平台>/{include,lib}         Windows 单 ABI 构建；iOS（fat 库）
#   lib  : <库>/<平台>/include + lib/<abi>   spdlog（Windows）
# flat 目录没有 abi 层，靠版本标记文件（version-*.txt 里的 platform 行）核对架构，
# 避免把 x64 的库链进 x86 工程。
macro(_tg3_locate comp)
    set(_p "")
    set(_ld "")
    set(_ver "")
    set(_why "")
    set(_base "${TGCapture3rd_ROOT}/${comp}/${_tg3_plat}")
    # abi 目录以 include 为准：只有空 lib 的 <abi>/ 是残留（如旧版 dry-run 建出来的），不能挑中
    if(_tg3_abi AND EXISTS "${_base}/${_tg3_abi}/include")
        set(_p "${_base}/${_tg3_abi}")
    elseif(EXISTS "${_base}/include" OR EXISTS "${_base}/lib")
        set(_p "${_base}")
    else()
        set(_why "未找到 ${_base}[/${_tg3_abi}]/{include,lib}（先用 FfmpegCompileShell 编出 ${comp}）")
    endif()
    if(_p)
        set(_ld "${_p}/lib")
        if(_tg3_abi AND IS_DIRECTORY "${_p}/lib/${_tg3_abi}")
            set(_ld "${_p}/lib/${_tg3_abi}")
        endif()
        file(GLOB _markers "${_p}/version-*.txt")
        if(_markers)
            list(GET _markers 0 _marker)
            file(STRINGS "${_marker}" _ver_line REGEX "^version[ \t]*:" LIMIT_COUNT 1)
            string(REGEX REPLACE "^version[ \t]*:[ \t]*" "" _ver "${_ver_line}")
            # 带 abi 层（目录或 lib/<abi>）的不需要核对；fat 库也不核对
            if(_tg3_abi AND _p STREQUAL _base AND NOT _ld MATCHES "/${_tg3_abi}$")
                file(STRINGS "${_marker}" _plat_line REGEX "^platform[ \t]*:" LIMIT_COUNT 1)
                if(_plat_line MATCHES "\\(([^)]*)\\)")
                    string(REPLACE "," ";" _built "${CMAKE_MATCH_1}")
                    string(REPLACE " " "" _built "${_built}")
                    if(NOT _tg3_abi IN_LIST _built)
                        set(_why "${_p} 是 ${CMAKE_MATCH_1} 的产物，与目标 ABI ${_tg3_abi} 不符（同一产物目录里单独编不同 ABI 会互相覆盖：一次 --abi x64,x86 一起编，或用不同 -o）")
                    endif()
                endif()
            endif()
        endif()
    endif()
endmacro()

function(_tg3_pick out dir)
    foreach(_name IN LISTS ARGN)
        if(EXISTS "${dir}/${_name}")
            set(${out} "${dir}/${_name}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${out} "" PARENT_SCOPE)
endfunction()

function(_tg3_add_static tgt file incdir)
    if(TARGET ${tgt})
        return()
    endif()
    add_library(${tgt} STATIC IMPORTED ${_tg3_global})
    # C++ 实现的静态库要求用 C++ 链接器（带上 libstdc++/libc++）；纯 C 的只声明 C，
    # 免得只启用了 C 语言的消费方因为缺 CXX 编译器而失败
    if(tgt MATCHES "::(srt|openh264|fdk-aac|libyuv|spdlog)$")
        set(_langs "C;CXX")
    else()
        set(_langs "C")
    endif()
    set_target_properties(${tgt} PROPERTIES
        IMPORTED_LOCATION "${file}"
        IMPORTED_LINK_INTERFACE_LANGUAGES "${_langs}")
    if(incdir AND IS_DIRECTORY "${incdir}")
        set_target_properties(${tgt} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${incdir}")
    endif()
    if(ARGN)
        set_property(TARGET ${tgt} PROPERTY INTERFACE_LINK_LIBRARIES ${ARGN})
    endif()
endfunction()

function(_tg3_add_interface tgt)
    if(TARGET ${tgt})
        return()
    endif()
    add_library(${tgt} INTERFACE IMPORTED ${_tg3_global})
    if(ARGN)
        set_property(TARGET ${tgt} PROPERTY INTERFACE_LINK_LIBRARIES ${ARGN})
    endif()
endfunction()

# 各平台静态库的系统依赖（按目标平台，不按宿主）
function(_tg3_syslibs out comp)
    set(_libs "")
    if(_tg3_plat STREQUAL "windows")
        if(comp STREQUAL "openssl")
            set(_libs ws2_32 gdi32 crypt32 advapi32 user32)
        elseif(comp STREQUAL "srt")
            set(_libs ws2_32)
        endif()
    elseif(_tg3_plat STREQUAL "linux")
        if(comp STREQUAL "openssl")
            set(_libs dl pthread)
        elseif(comp MATCHES "^(srt|openh264|spdlog)$")
            set(_libs pthread)
        endif()
        if(comp MATCHES "^(fdk-aac|openh264)$")
            list(APPEND _libs m)
        endif()
    elseif(_tg3_plat MATCHES "^(android|ohos)$" AND comp MATCHES "^(fdk-aac|openh264)$")
        set(_libs m)
    endif()
    set(${out} "${_libs}" PARENT_SCOPE)
endfunction()

# 结果经 _tg3_found / _tg3_reason / _tg3_prefix / _tg3_version 回传
macro(_tg3_result found reason)
    set(_tg3_found ${found} PARENT_SCOPE)
    set(_tg3_reason "${reason}" PARENT_SCOPE)
    set(_tg3_prefix "${_p}" PARENT_SCOPE)
    set(_tg3_version "${_ver}" PARENT_SCOPE)
endmacro()

function(_tg3_load_simple comp tgt)
    _tg3_locate(${comp})
    if(_why)
        _tg3_result(FALSE "${_why}")
        return()
    endif()
    _tg3_pick(_file "${_ld}" ${ARGN})
    if(NOT _file)
        _tg3_result(FALSE "${_ld} 里没有 ${ARGN}")
        return()
    endif()
    _tg3_syslibs(_sys ${comp})
    _tg3_add_static(${tgt} "${_file}" "${_p}/include" ${_sys})
    _tg3_result(TRUE "")
endfunction()

function(_tg3_load_openssl)
    _tg3_locate(openssl)
    if(_why)
        _tg3_result(FALSE "${_why}")
        return()
    endif()
    _tg3_pick(_crypto "${_ld}" libcrypto.lib crypto.lib libcrypto.a)
    _tg3_pick(_ssl "${_ld}" libssl.lib ssl.lib libssl.a)
    if(NOT _crypto OR NOT _ssl)
        _tg3_result(FALSE "${_ld} 里缺 libssl / libcrypto")
        return()
    endif()
    _tg3_syslibs(_sys openssl)
    _tg3_add_static(TGCapture3rd::crypto "${_crypto}" "${_p}/include" ${_sys})
    _tg3_add_static(TGCapture3rd::ssl "${_ssl}" "${_p}/include" TGCapture3rd::crypto)
    _tg3_add_interface(TGCapture3rd::openssl TGCapture3rd::ssl TGCapture3rd::crypto)
    _tg3_result(TRUE "")
endfunction()

function(_tg3_load_spdlog)
    _tg3_locate(spdlog)
    if(_why)
        _tg3_result(FALSE "${_why}")
        return()
    endif()
    _tg3_pick(_file "${_ld}" spdlog.lib libspdlog.a)
    if(NOT _file)
        _tg3_result(FALSE "${_ld} 里没有 spdlog 静态库")
        return()
    endif()
    _tg3_syslibs(_sys spdlog)
    _tg3_add_static(TGCapture3rd::spdlog "${_file}" "${_p}/include" ${_sys})
    # 编译版 spdlog：头文件按"非 header-only"展开，否则会与静态库里的实现重复定义
    set_property(TARGET TGCapture3rd::spdlog PROPERTY INTERFACE_COMPILE_DEFINITIONS SPDLOG_COMPILED_LIB)
    _tg3_result(TRUE "")
endfunction()

function(_tg3_load_json)
    # header-only：与平台无关，<根>/json/{single_include,include}
    set(_p "${TGCapture3rd_ROOT}/json")
    set(_ver "")
    file(GLOB _markers "${_p}/version-*.txt")
    if(_markers)
        list(GET _markers 0 _marker)
        file(STRINGS "${_marker}" _ver_line REGEX "^version[ \t]*:" LIMIT_COUNT 1)
        string(REGEX REPLACE "^version[ \t]*:[ \t]*" "" _ver "${_ver_line}")
    endif()
    set(_inc "")
    foreach(_sub IN ITEMS single_include include)
        if(EXISTS "${_p}/${_sub}/nlohmann/json.hpp")
            list(APPEND _inc "${_p}/${_sub}")
        endif()
    endforeach()
    if(NOT _inc)
        _tg3_result(FALSE "未找到 ${_p}/single_include/nlohmann/json.hpp")
        return()
    endif()
    if(NOT TARGET TGCapture3rd::json)
        add_library(TGCapture3rd::json INTERFACE IMPORTED ${_tg3_global})
        set_target_properties(TGCapture3rd::json PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_inc}")
    endif()
    _tg3_result(TRUE "")
endfunction()

# .pc 里的库名 / 包名 -> 导入目标；其余视为系统库原样透传
function(_tg3_map_lib out name)
    if(name IN_LIST _TG3_FFMPEG_LIBS)
        set(_t "TGCapture3rd::${name}")
    elseif(name MATCHES "^(lib)?ssl$")
        set(_t TGCapture3rd::ssl)
    elseif(name MATCHES "^(lib)?crypto$")
        set(_t TGCapture3rd::crypto)
    elseif(name MATCHES "^(srt|srt_static|libsrt|haisrt)$")
        set(_t TGCapture3rd::srt)
    elseif(name MATCHES "^(z|zs|zlib|zlibstatic)$")
        set(_t TGCapture3rd::zlib)
    elseif(name STREQUAL "fdk-aac")
        set(_t TGCapture3rd::fdk-aac)
    elseif(name STREQUAL "openh264")
        set(_t TGCapture3rd::openh264)
    else()
        set(_t "${name}")
    endif()
    set(${out} "${_t}" PARENT_SCOPE)
endfunction()

function(_tg3_map_pkg out pkg)
    set(_t "")
    if(pkg MATCHES "^lib(.+)$" AND CMAKE_MATCH_1 IN_LIST _TG3_FFMPEG_LIBS)
        set(_t "TGCapture3rd::${CMAKE_MATCH_1}")
    elseif(pkg STREQUAL "openssl")
        set(_t TGCapture3rd::openssl)
    elseif(pkg MATCHES "^(libssl|libcrypto|srt|haisrt|zlib|fdk-aac|openh264)$")
        _tg3_map_lib(_t "${pkg}")
    endif()
    set(${out} "${_t}" PARENT_SCOPE)
endfunction()

# 读 ffmpeg 的 lib<name>.pc 得到链接依赖（与 pkg-config --static 同一来源）：
#   静态构建时 ffmpeg 把依赖写在 Requires / Libs；共享构建时写在 *.private，
#   而 DLL 已经把静态依赖吃进去了，所以共享时跳过 Libs.private。
function(_tg3_pc_deps out pc self shared)
    set(_deps "")
    if(NOT EXISTS "${pc}")
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    file(STRINGS "${pc}" _lines)
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^Requires(\\.private)?:(.*)$")
            string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_+.-]*" _pkgs "${CMAKE_MATCH_2}")
            foreach(_pkg IN LISTS _pkgs)
                _tg3_map_pkg(_t "${_pkg}")
                if(_t)
                    list(APPEND _deps "${_t}")
                endif()
            endforeach()
        elseif(_line MATCHES "^Libs(\\.private)?:(.*)$")
            if(CMAKE_MATCH_1 AND shared)
                continue()
            endif()
            separate_arguments(_toks UNIX_COMMAND "${CMAKE_MATCH_2}")
            set(_fw FALSE)
            foreach(_tok IN LISTS _toks)
                set(_name "")
                if(_fw)
                    list(APPEND _deps "-framework ${_tok}")
                    set(_fw FALSE)
                elseif(_tok STREQUAL "-framework")
                    set(_fw TRUE)
                elseif(_tok MATCHES "^[-/][Ll][Ii][Bb][Pp][Aa][Tt][Hh]:" OR _tok MATCHES "^-L")
                    # 搜索路径：导入目标自带完整路径，旧的绝对路径（产物挪过位置）也就无所谓了
                elseif(_tok MATCHES "^-l(.+)$")
                    set(_name "${CMAKE_MATCH_1}")
                elseif(_tok MATCHES "^([^/\\\\:]+)\\.[Ll][Ii][Bb]$")
                    set(_name "${CMAKE_MATCH_1}")
                elseif(IS_ABSOLUTE "${_tok}")
                    if(EXISTS "${_tok}")
                        list(APPEND _deps "${_tok}")
                    endif()
                else()
                    list(APPEND _deps "${_tok}")      # -pthread / -Wl,... 之类的链接选项
                endif()
                if(_name AND NOT _name STREQUAL self)
                    _tg3_map_lib(_t "${_name}")
                    list(APPEND _deps "${_t}")
                endif()
            endforeach()
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _deps)
    list(REMOVE_ITEM _deps "TGCapture3rd::${self}")
    set(${out} "${_deps}" PARENT_SCOPE)
endfunction()

function(_tg3_load_ffmpeg)
    _tg3_locate(ffmpeg)
    if(_why)
        _tg3_result(FALSE "${_why}")
        return()
    endif()
    set(_present "")
    set(_dlls "")
    foreach(_n IN LISTS _TG3_FFMPEG_LIBS)
        set(_kind "")
        file(GLOB _dll "${_p}/bin/${_n}-*.dll")
        if(_tg3_plat STREQUAL "windows" AND EXISTS "${_ld}/${_n}.lib" AND _dll)
            list(GET _dll 0 _dll)
            set(_kind SHARED)
            set(_file_${_n} "${_ld}/${_n}.lib")
            set(_dll_${_n} "${_dll}")
            list(APPEND _dlls "${_dll}")
        elseif(EXISTS "${_ld}/lib${_n}.a")
            set(_kind STATIC)
            set(_file_${_n} "${_ld}/lib${_n}.a")
        elseif(EXISTS "${_ld}/${_n}.lib")
            set(_kind STATIC)
            set(_file_${_n} "${_ld}/${_n}.lib")
        endif()
        if(_kind)
            set(_kind_${_n} ${_kind})
            list(APPEND _present ${_n})
        endif()
    endforeach()
    if(NOT "avutil" IN_LIST _present)
        _tg3_result(FALSE "${_ld} 里没有 avutil（.lib + bin/*.dll 或 libavutil.a）")
        return()
    endif()

    # 先解析、校验依赖，全部满足再建目标（避免留下半截目标）
    set(_missing "")
    foreach(_n IN LISTS _present)
        set(_shared FALSE)
        if(_kind_${_n} STREQUAL "SHARED")
            set(_shared TRUE)
        endif()
        _tg3_pc_deps(_deps_${_n} "${_ld}/pkgconfig/lib${_n}.pc" ${_n} ${_shared})
        foreach(_d IN LISTS _deps_${_n})
            if(_d MATCHES "^TGCapture3rd::(.+)$" AND NOT CMAKE_MATCH_1 IN_LIST _TG3_FFMPEG_LIBS AND NOT TARGET ${_d})
                list(APPEND _missing "${_d}")
            endif()
            if(_d MATCHES "^TGCapture3rd::(.+)$" AND CMAKE_MATCH_1 IN_LIST _TG3_FFMPEG_LIBS
               AND NOT CMAKE_MATCH_1 IN_LIST _present)
                list(APPEND _missing "${_d}")
            endif()
        endforeach()
    endforeach()
    if(_missing)
        list(REMOVE_DUPLICATES _missing)
        string(REPLACE ";" ", " _missing "${_missing}")
        _tg3_result(FALSE "静态 ffmpeg 依赖的 ${_missing} 不可用（对应组件未找到或架构不符）")
        return()
    endif()

    foreach(_n IN LISTS _present)
        set(_t "TGCapture3rd::${_n}")
        if(TARGET ${_t})
            continue()
        endif()
        if(_kind_${_n} STREQUAL "SHARED")
            add_library(${_t} SHARED IMPORTED ${_tg3_global})
            set_target_properties(${_t} PROPERTIES
                IMPORTED_IMPLIB "${_file_${_n}}"
                IMPORTED_LOCATION "${_dll_${_n}}")
        else()
            add_library(${_t} STATIC IMPORTED ${_tg3_global})
            set_target_properties(${_t} PROPERTIES
                IMPORTED_LOCATION "${_file_${_n}}"
                IMPORTED_LINK_INTERFACE_LANGUAGES "C")
        endif()
        set_target_properties(${_t} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_p}/include")
        if(_deps_${_n})
            set_property(TARGET ${_t} PROPERTY INTERFACE_LINK_LIBRARIES ${_deps_${_n}})
        endif()
    endforeach()

    set(_all "")
    foreach(_n IN ITEMS avdevice avfilter avformat avcodec swscale swresample postproc avutil)
        if(_n IN_LIST _present)
            list(APPEND _all "TGCapture3rd::${_n}")
        endif()
    endforeach()
    _tg3_add_interface(TGCapture3rd::ffmpeg ${_all})
    set(_tg3_dlls "${_dlls}" PARENT_SCOPE)
    _tg3_result(TRUE "")
endfunction()

function(_tg3_load comp)
    set(_tg3_dlls "" PARENT_SCOPE)
    if(comp STREQUAL "ffmpeg")
        _tg3_load_ffmpeg()
        set(_tg3_dlls "${_tg3_dlls}" PARENT_SCOPE)
    elseif(comp STREQUAL "openssl")
        _tg3_load_openssl()
    elseif(comp STREQUAL "spdlog")
        _tg3_load_spdlog()
    elseif(comp STREQUAL "json")
        _tg3_load_json()
    elseif(comp STREQUAL "zlib")
        _tg3_load_simple(zlib TGCapture3rd::zlib zs.lib z.lib zlib.lib zlibstatic.lib libz.a)
    elseif(comp STREQUAL "srt")
        _tg3_load_simple(srt TGCapture3rd::srt srt_static.lib srt.lib libsrt.lib libsrt.a)
    elseif(comp STREQUAL "fdk-aac")
        _tg3_load_simple(fdk-aac TGCapture3rd::fdk-aac fdk-aac.lib libfdk-aac.lib libfdk-aac.a)
    elseif(comp STREQUAL "openh264")
        _tg3_load_simple(openh264 TGCapture3rd::openh264 openh264.lib libopenh264.lib libopenh264.a)
    elseif(comp STREQUAL "libyuv")
        _tg3_load_simple(libyuv TGCapture3rd::libyuv yuv.lib libyuv.lib libyuv.a libyuv_static.a)
    endif()
    set(_tg3_found ${_tg3_found} PARENT_SCOPE)
    set(_tg3_reason "${_tg3_reason}" PARENT_SCOPE)
    set(_tg3_prefix "${_tg3_prefix}" PARENT_SCOPE)
    set(_tg3_version "${_tg3_version}" PARENT_SCOPE)
endfunction()

# ------------------------------------------------------------------ 组件
set(_tg3_requested ${TGCapture3rd_FIND_COMPONENTS})
set(_tg3_explicit TRUE)
if(NOT _tg3_requested)
    set(_tg3_requested ${TGCapture3rd_ALL_COMPONENTS})
    set(_tg3_explicit FALSE)
endif()
set(_tg3_unknown "")
foreach(_c IN LISTS _tg3_requested)
    if(NOT _c IN_LIST TGCapture3rd_ALL_COMPONENTS)
        list(APPEND _tg3_unknown ${_c})
    endif()
endforeach()
if(_tg3_unknown)
    string(REPLACE ";" ", " _tg3_unknown "${_tg3_unknown}")
    string(REPLACE ";" ", " _tg3_all_txt "${TGCapture3rd_ALL_COMPONENTS}")
    _tg3_fail("未知组件: ${_tg3_unknown}（可选: ${_tg3_all_txt}）")
endif()

set(TGCapture3rd_RUNTIME_DLLS "")
set(_tg3_loaded "")
foreach(_c IN LISTS TGCapture3rd_ALL_COMPONENTS)
    # ffmpeg 的依赖库作为内部组件一起加载：静态 ffmpeg 要靠它们的目标完成链接
    if(NOT _c IN_LIST _tg3_requested AND NOT ("ffmpeg" IN_LIST _tg3_requested AND _c IN_LIST _TG3_FFMPEG_DEPS))
        continue()
    endif()
    _tg3_load(${_c})
    set(TGCapture3rd_${_c}_FOUND ${_tg3_found})
    set(TGCapture3rd_${_c}_PREFIX "${_tg3_prefix}")
    set(TGCapture3rd_${_c}_VERSION "${_tg3_version}")
    set(_tg3_reason_${_c} "${_tg3_reason}")
    if(_tg3_found)
        list(APPEND _tg3_loaded ${_c})
        if(_c STREQUAL "ffmpeg")
            set(TGCapture3rd_RUNTIME_DLLS "${_tg3_dlls}")
        endif()
    endif()
endforeach()

set(TGCapture3rd_FOUND TRUE)
set(_tg3_errors "")
foreach(_c IN LISTS _tg3_requested)
    if(TGCapture3rd_${_c}_FOUND)
        continue()
    endif()
    if(_tg3_explicit AND TGCapture3rd_FIND_REQUIRED_${_c})
        set(TGCapture3rd_FOUND FALSE)
        string(APPEND _tg3_errors "\n  ${_c}: ${_tg3_reason_${_c}}")
    elseif(_tg3_explicit AND NOT TGCapture3rd_FIND_QUIETLY)
        message(STATUS "TGCapture3rd: 可选组件 ${_c} 不可用: ${_tg3_reason_${_c}}")
    endif()
endforeach()
if(NOT _tg3_loaded)
    set(TGCapture3rd_FOUND FALSE)
    string(APPEND _tg3_errors "\n  ${TGCapture3rd_ROOT} 下没有 ${_tg3_plat}/${_tg3_abi} 的任何产物")
endif()
if(NOT TGCapture3rd_FOUND)
    set(TGCapture3rd_NOT_FOUND_MESSAGE
        "TGCapture3rd（${TGCapture3rd_ROOT}，platform=${_tg3_plat} abi=${_tg3_abi}）缺少组件:${_tg3_errors}")
elseif(NOT TGCapture3rd_FIND_QUIETLY)
    string(REPLACE ";" " " _tg3_loaded_txt "${_tg3_loaded}")
    message(STATUS "Found TGCapture3rd: ${TGCapture3rd_ROOT} (platform=${_tg3_plat} abi=${_tg3_abi}"
                   " profile=${TGCapture3rd_PROFILE} components: ${_tg3_loaded_txt})")
endif()
